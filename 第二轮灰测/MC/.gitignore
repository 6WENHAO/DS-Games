# --- editor / OS noise ------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# --- dependencies (there are none at runtime, but keep npm tidy) ------
node_modules/
package-lock.json

# --- generated caches -------------------------------------------------
# tools/.cache holds the upstream file index used by fetch-assets.mjs so
# repeat runs do not hit the network. Safe to delete at any time.
tools/.cache/

# Temporary harness page written by tools/play-probe.mjs on every run.
tools/_play-harness.html
tools/_*.mjs

# --- downloaded art ---------------------------------------------------
# Textures and sounds are fetched by tools/fetch-assets.mjs and
# tools/fetch-sounds.mjs. Uncomment these to keep them out of version
# control and let contributors download their own copies instead.
# assets/textures/
# assets/sounds/*.ogg
# assets/sounds/*.wav

# --- local worlds -----------------------------------------------------
# Saves live in the browser's IndexedDB, not on disk, so there is nothing
# to ignore here - listed only so the intent is documented.
